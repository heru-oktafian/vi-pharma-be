# Vi-Pharma Backend Environment Configuration

# Server
APP_ENV=development
APP_PORT=8080
APP_NAME=Vi-Pharma-Backend

# PostgreSQL Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vipharma_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# JWT Authentication
JWT_SECRET=super-secret-vipharma-key-change-in-production
JWT_EXPIRATION_HOURS=24
